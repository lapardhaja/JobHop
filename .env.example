# ApplyPilot Environment Configuration
# Copy to ~/.applypilot/.env and fill in your values.

# Text backend (Codex CLI is the default; no model API key is needed)
APPLYPILOT_AI_PROVIDER=codex
# CODEX_MODEL=             # Optional Codex model override

# Optional API backend. Set APPLYPILOT_AI_PROVIDER=api to use these providers.
# APPLYPILOT_API_PROVIDER=gemini  # Optional: gemini, openai, or local
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# LLM_URL=http://127.0.0.1:8080/v1  # Local API-compatible server
# LLM_MODEL=                         # API model override
# LLM_API_KEY=                       # Optional local server key

# Auto-Apply (optional)
CAPSOLVER_API_KEY=        # For CAPTCHA solving during auto-apply

# Proxy (optional, for scraping)
# PROXY=host:port:user:pass
